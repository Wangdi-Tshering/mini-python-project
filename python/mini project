
from tkinter import *
from tkinter import messagebox

# Create main window
root = Tk()
root.title("Student Registration Form")
root.geometry("400x500")

# Student Name
Label(root, text="Student Registration Form",
      font=("Arial", 16, "bold")).pack(pady=10)

Label(root, text="Student Name:").pack()
name_entry = Entry(root, width=30)
name_entry.pack(pady=5)

# Roll Number
Label(root, text="Roll Number:").pack()
roll_entry = Entry(root, width=30)
roll_entry.pack(pady=5)

# Email
Label(root, text="Email:").pack()
email_entry = Entry(root, width=30)
email_entry.pack(pady=5)

# Gender
Label(root, text="Gender:").pack()

gender = StringVar(value="Male")

Radiobutton(root, text="Male", variable=gender,
            value="Male").pack()

Radiobutton(root, text="Female", variable=gender,
            value="Female").pack()

Radiobutton(root, text="Other", variable=gender,
            value="Other").pack()

# Course Dropdown
Label(root, text="Select Course:").pack(pady=5)

course = StringVar(value="BCA")

courses = ["BCA", "BBA", "B.Tech", "MCA", "MBA"]

course_menu = OptionMenu(root, course, *courses)
course_menu.pack()

# Hobbies
Label(root, text="Select Hobbies:").pack(pady=5)

hobby1 = IntVar()
hobby2 = IntVar()
hobby3 = IntVar()

Checkbutton(root, text="Reading",
            variable=hobby1).pack()

Checkbutton(root, text="Sports",
            variable=hobby2).pack()

Checkbutton(root, text="Music",
            variable=hobby3).pack()

# Submit Function
def submit():
    name = name_entry.get()
    roll = roll_entry.get()
    email = email_entry.get()
    gen = gender.get()
    selected_course = course.get()

    hobbies = []

    if hobby1.get():
        hobbies.append("Reading")
    if hobby2.get():
        hobbies.append("Sports")
    if hobby3.get():
        hobbies.append("Music")

    if not hobbies:
        hobbies.append("None")

    info = (
        "Student Information\n\n"
        + "Name: " + name + "\n"
        + "Roll Number: " + roll + "\n"
        + "Email: " + email + "\n"
        + "Gender: " + gen + "\n"
        + "Course: " + selected_course + "\n"
        + "Hobbies: " + ", ".join(hobbies)
    )

    messagebox.showinfo("Registration Details", info)

# Submit Button
Button(root, text="Submit", command=submit,
       bg="green", fg="white",
       font=("Arial", 12, "bold")).pack(pady=15)

# Run application
root.mainloop()
